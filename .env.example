# Backend server port (development and production Node server)
PORT=3000

# Server-side Gemini API key (keep private; never prefix with VITE_)
GEMINI_API_KEY=

# Comma-separated frontend origins allowed to call /api/* when frontend & API are hosted separately
# Example: https://your-site.vercel.app,https://your-user.github.io
ALLOWED_ORIGINS=

# Optional public URL of your deployed Express API server when hosting static frontend separately (Vercel/Netlify/GitHub Pages)
# Leave empty for same-origin full-stack deployments (`npm run start`)
VITE_API_BASE_URL=

# Optional base path for subpath static hosting (e.g. /skillbridge/ on GitHub Pages; defaults to /)
VITE_BASE_PATH=/
